# Copy to .env.production before: bun run build
# Never commit .env.production (real keys and domain).

# Your live site — must match the domain users visit (no trailing slash)
VITE_SITE_URL=https://yourdomain.com

# Production Turnstile keys from Cloudflare dashboard (domain must be allowed)
VITE_TURNSTILE_SITE_KEY=replace-with-production-site-key
VITE_TURNSTILE_ENABLED=true

# Same-origin deploy (nginx serves static + proxies /api and /ws to backend):
#   Leave API/WS vars unset — the app uses /api and wss://yourdomain.com/ws/chat/

# Split-origin (SPA on CDN, API on api.yourdomain.com):
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_API_PREFIX=https://api.yourdomain.com/api
# VITE_WS_URL=wss://api.yourdomain.com/ws/chat/
# Backend CORS must include https://yourdomain.com
