# Public site URL (canonical, Open Graph, sitemap — no trailing slash)
# Production: https://yourdomain.com
# Local dev: http://localhost:3000
VITE_SITE_URL=https://yourdomain.com
# Regenerates public/robots.txt + public/sitemap.xml: bun run seo:generate

# Cloudflare Turnstile (test keys work on localhost)
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=true
