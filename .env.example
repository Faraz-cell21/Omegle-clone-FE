# Local development — copy to .env
# Production deploy — copy .env.production.example to .env.production

# Public site URL (canonical, OG, sitemap — no trailing slash)
VITE_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (test keys work on localhost)
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_ENABLED=true

# --- Optional: only if API/WebSocket are NOT proxied on the same host as the SPA ---
# Same-origin (recommended): nginx proxies /api and /ws to Django — leave these unset.
# Split-origin example:
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_API_PREFIX=https://api.yourdomain.com/api
# VITE_WS_URL=wss://api.yourdomain.com/ws/chat/
